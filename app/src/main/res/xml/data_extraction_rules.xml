<?xml version="1.0" encoding="utf-8"?>
<!-- Settings may travel to a new phone; sign-ins (encrypted with a key that stays on this device)
     and downloads must not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
